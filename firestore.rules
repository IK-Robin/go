rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /links/{alias} {
      function owner() {return googleUser() && resource.data.ownerUid == request.auth.uid;}
      allow get, list: if owner();
      allow create, update, delete: if false;
      match /daily/{day} {
        allow read: if googleUser() && get(/databases/$(database)/documents/links/$(alias)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
