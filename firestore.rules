rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function googleUser() {return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';}
  match /links/{alias} {
   function owner() {return googleUser() && resource.data.ownerUid == request.auth.uid;}
   function valid() {
    return request.resource.data.keys().hasOnly(['url','title','ownerUid','createdAt','updatedAt','enabled','expiresAt','clicks'])
      && request.resource.data.keys().hasAll(['url','title','ownerUid','createdAt'])
      && request.resource.data.url is string
      && request.resource.data.url.matches('https?://.+')
      && request.resource.data.url.size() <= 4096
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 100
      && request.resource.data.ownerUid is string
      && (!('enabled' in request.resource.data) || request.resource.data.enabled is bool)
      && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt == null || request.resource.data.expiresAt is string)
      && (!('clicks' in request.resource.data) || request.resource.data.clicks is int);
   }
   allow get: if true;
   allow list: if owner();
   allow create: if googleUser() && alias.matches('[A-Za-z0-9_-]{1,60}') && valid() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.clicks == 0;
   allow update: if owner() && valid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['url','title','enabled','expiresAt','updatedAt']) && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if owner();
   match /clickEvents/{eventId} {
     allow create: if exists(/databases/$(database)/documents/links/$(alias)) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.keys().hasAll(['at']) && request.resource.data.at == request.time;
     allow get, list: if googleUser() && get(/databases/$(database)/documents/links/$(alias)).data.ownerUid == request.auth.uid;
     allow update, delete: if false;
   }
  }
 }
}